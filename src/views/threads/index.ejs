<%- include('../partials/header') %>
<%# UC21: danh sách thread. Mỗi thread có memberCount, postCount, joined (controller gắn). Mọi dữ liệu người dùng được escape %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Threads</h1>
  <% if (currentUser) { %>
    <a class="btn btn-primary" href="/threads/new">Tạo thread</a>
  <% } %>
</div>

<% if (threads.length === 0) { %>
  <div class="empty-state">
    <p class="empty-state__text">Chưa có thread nào</p>
    <% if (currentUser) { %>
      <a class="btn btn-primary" href="/threads/new">Tạo thread</a>
    <% } %>
  </div>
<% } %>

<% threads.forEach(function (t) { %>
  <article class="post-row">
    <div class="post-row__main">
      <h2 class="post-row__title">
        <a href="/threads/<%= t.slug %>"><%= t.name %></a>
        <% if (t.joined) { %><span class="badge text-bg-success fs-6 align-middle">Đã tham gia</span><% } %>
      </h2>
      <% if (t.description) { %>
        <p class="post-row__excerpt"><%= t.description.slice(0, 200) %><%= t.description.length > 200 ? '…' : '' %></p>
      <% } %>
      <div class="post-row__footer">
        <div class="post-row__tags">
          <% if (t.tag) { %>
            <a class="tag-chip" href="/tags/<%= encodeURIComponent(t.tag) %>"><%= t.tag %></a>
          <% } %>
        </div>
        <div class="post-row__meta">
          <span class="text-secondary"><%= t.memberCount %> thành viên</span>
          <span class="text-secondary">· <%= t.postCount %> bài</span>
          <span class="text-secondary">· tạo bởi <%= t.author ? t.author.username : 'Không rõ' %></span>
        </div>
      </div>
    </div>
  </article>
<% }) %>

<%- include('../partials/pagination') %>

<%- include('../partials/footer') %>
