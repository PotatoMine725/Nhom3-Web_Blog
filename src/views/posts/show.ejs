<%- include('../partials/header') %>

<nav aria-label="breadcrumb" class="small mb-2">
  <ol class="breadcrumb mb-0">
    <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
    <li class="breadcrumb-item active" aria-current="page">Bài viết</li>
  </ol>
</nav>

<article>
  <h1 class="h3 mb-2">
    <%= post.title %>
    <% if (post.status === 'draft') { %><span class="badge text-bg-secondary fs-6">Nháp</span><% } %>
  </h1>

  <div class="post-meta mb-3">
    <%- include('../partials/avatar', { name: post.author ? post.author.username : '?', size: 28 }) %>
    <strong><%= post.author ? post.author.username : 'Không rõ' %></strong>
    <span class="text-secondary" title="<%= post.createdAt.toLocaleString('vi-VN') %>"><%= timeAgo(post.createdAt) %></span>
    <% if (post.updatedAt.getTime() !== post.createdAt.getTime()) { %>
      <span class="text-secondary" title="<%= post.updatedAt.toLocaleString('vi-VN') %>">· đã sửa <%= timeAgo(post.updatedAt) %></span>
    <% } %>
    <span class="text-secondary">· ~<%= readingTime(post.content) %> phút đọc</span>
  </div>

  <% if (post.tags.length) { %>
    <div class="mb-3">
      <% post.tags.forEach(function (tag) { %>
        <span class="tag-chip"><%= tag %></span>
      <% }) %>
    </div>
  <% } %>

  <div class="post-content mb-3"><%= post.content %></div>

  <%# Thanh hành động. Nút sao chép chỉ hiện khi có JS (xem app.js), tránh nút chết %>
  <div class="post-actions">
    <a class="post-actions__item" href="#comments" title="Xem và viết bình luận">Bình luận (<%= comments.length %>)</a>
    <button type="button" class="post-actions__item" id="copyLinkBtn" hidden title="Sao chép liên kết bài viết">Sao chép liên kết</button>
    <% if (canEdit) { %>
      <a class="post-actions__item" href="/posts/<%= post.slug %>/edit">Sửa</a>
      <button type="button" class="post-actions__item post-actions__item--danger" data-bs-toggle="modal" data-bs-target="#deletePostModal">Xoá</button>
    <% } %>
  </div>
</article>

<% if (canEdit) { %>
  <div class="modal fade" id="deletePostModal" tabindex="-1" aria-labelledby="deletePostModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title h5" id="deletePostModalLabel">Xoá bài viết?</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <div class="modal-body">
          Bài viết và toàn bộ bình luận của nó sẽ bị xoá, không khôi phục được.
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Huỷ</button>
          <form action="/posts/<%= post.slug %>/delete" method="post">
            <button class="btn btn-danger">Xoá bài</button>
          </form>
        </div>
      </div>
    </div>
  </div>
<% } %>

<section id="comments" class="mt-5">
  <h2 class="h5 mb-3">Bình luận (<%= comments.length %>)</h2>

  <% if (!comments.length) { %>
    <p class="text-secondary">Chưa có bình luận nào.</p>
  <% } %>
  <% comments.forEach(function (c) { %>
    <div class="border-bottom py-2">
      <div class="small text-secondary">
        <strong><%= c.author ? c.author.username : 'Không rõ' %></strong>
        · <%= c.createdAt.toLocaleString('vi-VN') %>
      </div>
      <div class="comment-content"><%= c.content %></div>
      <% if (c.canDelete) { %>
        <form action="/comments/<%= c._id %>/delete" method="post" onsubmit="return confirm('Xoá bình luận này?')">
          <button class="btn btn-sm btn-outline-danger mt-1">Xoá</button>
        </form>
      <% } %>
    </div>
  <% }) %>

  <div class="mt-4">
    <% if (post.status !== 'published') { %>
      <p class="text-secondary">Bài nháp chưa nhận bình luận.</p>
    <% } else if (currentUser) { %>
      <% if (errors.length) { %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% errors.forEach(function (msg) { %>
              <li><%= msg %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>
      <form action="/posts/<%= post.slug %>/comments" method="post">
        <div class="mb-2">
          <textarea class="form-control" name="content" rows="3" aria-label="Bình luận"><%= commentContent %></textarea>
          <div class="form-text">Tối đa 1000 ký tự.</div>
        </div>
        <button class="btn btn-primary">Gửi</button>
      </form>
    <% } else { %>
      <p>Hãy <a href="/login">đăng nhập</a> để bình luận.</p>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
