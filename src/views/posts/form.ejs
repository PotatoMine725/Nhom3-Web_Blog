<%- include('../partials/header') %>

<div class="content-narrow">
<h1 class="h3 mb-3"><%= title %></h1>

<% if (errors.length) { %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% errors.forEach(function (msg) { %>
        <li><%= msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<%# multipart để gửi kèm ảnh bìa; uploadCover (multer) đọc cả các ô chữ %>
<form action="<%= action %>" method="post" enctype="multipart/form-data">
  <div class="mb-3">
    <label class="form-label" for="title">Tiêu đề</label>
    <input class="form-control" id="title" name="title" value="<%= values.title %>">
  </div>
  <div class="mb-3">
    <label class="form-label" for="content">Nội dung</label>
    <textarea class="form-control" id="content" name="content" rows="12"><%= values.content %></textarea>
  </div>
  <div class="mb-3">
    <label class="form-label" for="category">Danh mục</label>
    <select class="form-select w-auto" id="category" name="category">
      <option value="">Chưa phân loại</option>
      <% (locals.categories || []).forEach(function (c) { %>
        <option value="<%= c._id %>" <%= values.category === String(c._id) ? 'selected' : '' %>><%= c.name %></option>
      <% }) %>
    </select>
  </div>
  <%# Chỉ liệt kê thread tác giả bài đã tham gia (+ thread hiện tại của bài), BR12 %>
  <div class="mb-3">
    <label class="form-label" for="thread">Thread</label>
    <select class="form-select w-auto" id="thread" name="thread">
      <option value="">Không thuộc thread</option>
      <% (locals.threads || []).forEach(function (t) { %>
        <option value="<%= t._id %>" <%= values.thread === String(t._id) ? 'selected' : '' %>><%= t.name %></option>
      <% }) %>
    </select>
  </div>
  <div class="mb-3">
    <label class="form-label" for="tags">Tag</label>
    <input class="form-control" id="tags" name="tags" value="<%= values.tags %>">
    <div class="form-text">Cách nhau bằng dấu phẩy, tối đa 10 tag.</div>
  </div>
  <div class="mb-3">
    <label class="form-label" for="status">Trạng thái</label>
    <select class="form-select w-auto" id="status" name="status">
      <option value="draft" <%= values.status === 'draft' ? 'selected' : '' %>>Nháp</option>
      <option value="published" <%= values.status === 'published' ? 'selected' : '' %>>Đăng</option>
    </select>
  </div>
  <%# Ô ảnh bìa đặt cuối form: trình duyệt gửi các ô chữ trước, ảnh lỗi thì các ô chữ vẫn đọc được để hiện lại %>
  <div class="mb-3">
    <label class="form-label" for="coverImage">Ảnh bìa (không bắt buộc)</label>
    <% if (locals.coverImage) { %>
      <div class="mb-2">
        <img class="cover-preview" src="/uploads/<%= coverImage %>" alt="Ảnh bìa hiện tại">
      </div>
      <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="removeCover" name="removeCover" value="1" <%= locals.removeChecked ? 'checked' : '' %>>
        <label class="form-check-label" for="removeCover">Xoá ảnh bìa</label>
      </div>
    <% } %>
    <input class="form-control" type="file" id="coverImage" name="coverImage" accept="image/jpeg,image/png,image/webp">
    <div class="form-text">JPG, PNG hoặc WEBP, tối đa 2 MB.<% if (locals.coverImage) { %> Chọn ảnh mới để thay ảnh hiện tại.<% } %></div>
  </div>
  <button class="btn btn-primary">Lưu</button>
</form>
</div>

<%- include('../partials/footer') %>
