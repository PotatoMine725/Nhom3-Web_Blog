<%- include('../partials/header') %>

<div class="content-narrow">
<h1 class="h3 mb-3">Đăng ký</h1>

<% if (errors.length) { %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% errors.forEach(function (msg) { %>
        <li><%= msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<form action="/register" method="post">
  <div class="mb-3">
    <label class="form-label" for="username">Username</label>
    <input class="form-control" id="username" name="username" value="<%= values.username || '' %>">
  </div>
  <div class="mb-3">
    <label class="form-label" for="email">Email</label>
    <input class="form-control" id="email" name="email" value="<%= values.email || '' %>">
  </div>
  <div class="mb-3">
    <label class="form-label" for="password">Mật khẩu</label>
    <input class="form-control" type="password" id="password" name="password">
  </div>
  <div class="mb-3">
    <label class="form-label" for="confirmPassword">Nhập lại mật khẩu</label>
    <input class="form-control" type="password" id="confirmPassword" name="confirmPassword">
  </div>
  <button class="btn btn-primary">Đăng ký</button>
</form>

<p class="mt-3">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
</div>

<%- include('../partials/footer') %>
