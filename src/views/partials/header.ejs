<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Nhom3 Blog</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="site-header">
  <div class="site-header__inner">
    <button class="btn site-header__icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#leftNavMobile" aria-controls="leftNavMobile" aria-label="Mở menu">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14"/></svg>
    </button>

    <a class="site-header__brand" href="/">
      <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
        <rect width="28" height="28" rx="6" fill="#f48024"/>
        <path d="M8 9h12M8 14h12M8 19h7" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/>
      </svg>
      <span class="d-none d-sm-inline">Nhom3 Blog</span>
    </a>

    <form id="searchForm" class="site-header__search collapse d-lg-block" action="/search" method="get" role="search">
      <input id="searchInput" class="form-control" type="search" name="q" placeholder="Tìm bài viết…" aria-label="Tìm bài viết" title="Nhấn / để tìm nhanh">
    </form>

    <div class="site-header__actions">
      <button class="btn site-header__icon-btn d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#searchForm" aria-controls="searchForm" aria-label="Tìm kiếm">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M13 13l4 4"/></svg>
      </button>

      <% if (currentUser) { %>
        <a class="btn btn-sm btn-primary" href="/posts/new" title="Viết bài mới">Viết bài</a>
        <div class="dropdown">
          <button class="btn p-0 border-0 rounded-circle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu tài khoản của <%= currentUser.username %>">
            <%- include('avatar', { name: currentUser.username, size: 32 }) %>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><span class="dropdown-item-text fw-semibold"><%= currentUser.username %></span></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/me/posts">Bài của tôi</a></li>
            <li>
              <form action="/logout" method="post">
                <button class="dropdown-item">Đăng xuất</button>
              </form>
            </li>
          </ul>
        </div>
      <% } else { %>
        <a class="btn btn-sm btn-outline-primary" href="/login">Đăng nhập</a>
        <a class="btn btn-sm btn-primary" href="/register">Đăng ký</a>
      <% } %>
    </div>
  </div>
</header>

<%# Menu trái trên màn hình nhỏ: trượt ra từ mép trái khi bấm nút ☰ %>
<div class="offcanvas offcanvas-start" tabindex="-1" id="leftNavMobile" aria-labelledby="leftNavMobileLabel">
  <div class="offcanvas-header">
    <h2 class="offcanvas-title h6" id="leftNavMobileLabel">Menu</h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
  </div>
  <div class="offcanvas-body">
    <%- include('left-nav') %>
  </div>
</div>

<div class="layout <%= locals.sidebar ? 'layout--sidebar' : '' %>">
  <aside class="layout__left d-none d-lg-block" aria-label="Menu chính">
    <%- include('left-nav') %>
  </aside>
  <main class="layout__main">
<% if (flash) { %>
    <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
      <%= flash.message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
<% } %>
