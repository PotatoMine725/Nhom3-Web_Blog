<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Nhom3 Blog</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-expand bg-body-tertiary border-bottom mb-4">
  <div class="container">
    <a class="navbar-brand fw-semibold" href="/">Nhom3 Blog</a>
    <form class="d-flex ms-auto me-3" action="/search" method="get">
      <input class="form-control form-control-sm" type="search" name="q" placeholder="Tìm bài viết...">
    </form>
    <% if (currentUser) { %>
      <a class="btn btn-sm btn-primary me-2" href="/posts/new">Viết bài</a>
      <form action="/logout" method="post" class="d-inline">
        <button class="btn btn-sm btn-outline-secondary">Đăng xuất</button>
      </form>
    <% } else { %>
      <a class="btn btn-sm btn-outline-primary me-2" href="/login">Đăng nhập</a>
      <a class="btn btn-sm btn-primary" href="/register">Đăng ký</a>
    <% } %>
  </div>
</nav>
<main class="container">
