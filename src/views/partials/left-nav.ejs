<%# Menu trái. Chỉ liệt kê mục đã có route; mục đang mở được tô đậm theo currentPath %>
<ul class="nav flex-column left-nav">
  <li>
    <a class="left-nav__link <%= currentPath === '/' ? 'active' : '' %>" href="/" <%- currentPath === '/' ? 'aria-current="page"' : '' %>>Trang chủ</a>
  </li>
  <li>
    <a class="left-nav__link <%= currentPath === '/popular' ? 'active' : '' %>" href="/popular" <%- currentPath === '/popular' ? 'aria-current="page"' : '' %>>Nổi bật</a>
  </li>
  <%# Tô đậm ở /threads và mọi trang con /threads/... %>
  <% var onThreads = currentPath === '/threads' || currentPath.indexOf('/threads/') === 0; %>
  <li>
    <a class="left-nav__link <%= onThreads ? 'active' : '' %>" href="/threads" <%- onThreads ? 'aria-current="page"' : '' %>>Threads</a>
  </li>
  <% if (currentUser) { %>
    <li>
      <a class="left-nav__link <%= currentPath === '/me/posts' ? 'active' : '' %>" href="/me/posts" <%- currentPath === '/me/posts' ? 'aria-current="page"' : '' %>>Bài của tôi</a>
    </li>
    <li>
      <a class="left-nav__link <%= currentPath === '/me/bookmarks' ? 'active' : '' %>" href="/me/bookmarks" <%- currentPath === '/me/bookmarks' ? 'aria-current="page"' : '' %>>Đã lưu</a>
    </li>
    <li>
      <a class="left-nav__link <%= currentPath === '/posts/new' ? 'active' : '' %>" href="/posts/new" <%- currentPath === '/posts/new' ? 'aria-current="page"' : '' %>>Viết bài</a>
    </li>
  <% } %>
</ul>
